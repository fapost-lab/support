{
  "name": "fapost/support",
  "description": "FAPost reusable Eloquent primitives — traits, base model, and model concerns",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.4",
    "illuminate/database": "^11.0 || ^12.0",
    "illuminate/support": "^11.0 || ^12.0",
    "fapost/foundation": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "FAPost\\Support\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FAPost\\Support\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": []
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
